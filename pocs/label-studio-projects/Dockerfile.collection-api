# Backend for the "Create collection" tab.
# Build context is this directory (the label-studio-projects branch).
FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY collection_api.py .

EXPOSE 8800
CMD ["uvicorn", "collection_api:app", "--host", "0.0.0.0", "--port", "8800"]
